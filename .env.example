# Optional settings. Copy to .env and restart after editing.
# The Python-only launcher uses 127.0.0.1; Compose overrides the container bind.
OPPORTUNITY_PORT=8765

# Set all three to use your own AI provider. No API call occurs until you prepare with AI.
AI_ENABLED=0
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# Optional Brave Web Search. Saved queries run only when discovery is invoked.
BRAVE_SEARCH_API_KEY=

# Optional: share a generated token between Compose and external clients.
# Leave unset for an automatically generated local token shown in Connections.
# OPPORTUNITY_TOKEN=
