{
  "name": "Opportunity Desk — Discover",
  "nodes": [
    {
      "id": "e3334c7441805b9e9366c7979f4fb9ba",
      "name": "Read before running",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -260,
        -540
      ],
      "parameters": {
        "content": "## Setup\n1. Run the companion service. Compose URL: http://agent:8765. If n8n and the service both run directly on the host, edit the HTTP URL to http://127.0.0.1:8765. Use the bundled Compose agent when n8n runs in Docker.\n2. Select a Header Auth credential named Opportunity Desk service, with header X-Opportunity-Token and the token shown in Connections.\n3. Intake/Prepare webhooks also require a separate Header Auth credential named Opportunity webhook access. Set header X-Workflow-Token to a separate random value.\n4. Workflows ship inactive. Discovery schedule also ships disabled. Configure sources, test manually, then enable the schedule and publish only when you want recurring runs.\n5. Provider failures are visible in discovery errors or the error response. Nothing in these workflows submits an application.",
        "height": 470,
        "width": 600
      }
    },
    {
      "id": "6e18d37076335433a208db2a5403cabf",
      "name": "Run discovery manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "07b31d675ef353a5bd2e7d2c9c18f970",
      "name": "Daily discovery — enable when ready",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        180
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "disabled": true
    },
    {
      "id": "2ae33b5819bc54d4a874e2bb032fd691",
      "name": "Call local assistant",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://agent:8765/api/discover",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {} }}",
        "options": {
          "timeout": 300000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Opportunity Desk service"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "e9250377b3b052389f705da2f845144a",
      "name": "Discovery service unavailable",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        600,
        110
      ],
      "parameters": {
        "errorMessage": "Discovery could not reach the companion service. Check its address, pairing credential, and local service logs."
      }
    }
  ],
  "connections": {
